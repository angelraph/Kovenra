# Public address of the site (no trailing slash). PUBLIC_BASE_URL also works (older name).
SITE_URL=https://kovenra.xyz

# Attribution code from the hackathon enrollment (ERC-8021). Not secret.
# Do not set REPO_SLUG: this code was issued by Loops House, not derived from the repo.
ATTRIBUTION_CODE=celo_09b3ddb9ca23

# Celo x402 facilitator key. Create it yourself at x402.celo.org (never paste it in chat).
X402_API_KEY=

# Settlement wallet: receives USD₮ ticket payments, converts on Textile FX, pays organizers.
# Use a fresh wallet that only ever holds small working balances.
SETTLER_ADDRESS=0x...
SETTLER_PRIVATE_KEY=

CELO_RPC_URL=https://forno.celo.org

# Postgres (Neon or Vercel Postgres). Without it, local dev stores data in .data/kovenra.json
DATABASE_URL=

# Random secrets: signs ticket QR codes, protects the settlement retry cron.
TICKET_SECRET=
CRON_SECRET=

# Kovenra's own agent identity (ERC-8004, in the Self Agent ID registry). Public, not secret.
# "npm run agent:register" prints both values.
KOVENRA_AGENT_ID=
KOVENRA_AGENT_ADDRESS=

# Only for "npm run demo:buyers -- --pay": a wallet holding a little USD₮ to buy one test ticket.
# Keep this in .env.local on your own computer only, never in Vercel.
DEMO_PAYER_KEY=

# Optional tuning
SELF_MAX_AGENTS_PER_HUMAN=10
FX_BUFFER_BPS=60
